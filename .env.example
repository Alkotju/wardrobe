# --- Runtime ---
NODE_ENV=production
PORT=3000

# --- MongoDB (service name from docker-compose) ---
MONGO_URI=mongodb://mongo:27017/wardrobe

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-64-chars
JWT_EXPIRY=7d
BCRYPT_ROUNDS=12

# --- CORS ---
# Origin of the frontend served by nginx (or a separate dev origin).
FRONTEND_ORIGIN=https://localhost

# --- Uploads ---
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=26214400

# --- User limits ---
MAX_USERS=20

# --- External APIs (yr.no + Nominatim require an identifying UA) ---
YR_USER_AGENT=WardrobeApp/1.0 your@email.com

# --- First-run admin seed (used by `npm run seed` inside the api container) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-on-first-login
